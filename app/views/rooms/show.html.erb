<p style="color: green"><%= notice %></p>

<%= turbo_stream_from @room.to_gid_param %>

<div class="chat-container" style="display: flex; flex-direction: column; height: 100vh; position: fixed; top: 0; left: 0; right: 0; bottom: 0;">
  <%= turbo_frame_tag "room", style: "flex-shrink: 0;" do %>
    <%= render @room %>

    <p>
      <%= link_to "Edit this room", edit_room_path(@room) %> |
      <%= link_to "Back to rooms", rooms_path, "data-turbo-frame": "_top" %>
    </p>
  <% end %>

  <div id="messages"
       data-controller="messages"
       style="flex: 1; overflow-y: auto; margin-bottom: 0; padding: 10px; -webkit-overflow-scrolling: touch;">
    <%= render @room.messages %>
  </div>

  <div style="flex-shrink: 0; background: white; padding: 10px 0; border-top: 1px solid #eee;">
    <%= turbo_frame_tag "new_message", src: new_room_message_path(@room), target: "_top" %>
  </div>
</div>
